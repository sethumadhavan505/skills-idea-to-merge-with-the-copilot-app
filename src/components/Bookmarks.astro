---
---
<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p class="hint">Paste a URL with or without <code>https://</code> to create a short <code>mona-</code> link.</p>
  <p id="form-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" class="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl, STORAGE_KEY } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');
  const status = document.getElementById('form-status');
  let bookmarks = [];

  function setStatus(message) {
    if (status) status.textContent = message;
  }

  function readBookmarks() {
    try {
      bookmarks = loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      bookmarks = [];
      setStatus('Browser storage is unavailable. Bookmarks will not survive a reload.');
    }
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug}.`);
        } catch {
          setStatus('Could not copy the slug. Check clipboard permissions and try again.');
        }
      });

      item.append(link, document.createTextNode(' :: '), slug, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  function persistBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
      return true;
    } catch {
      setStatus('Browser storage is unavailable. Bookmarks will not survive a reload.');
      return false;
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(input?.value ?? '');
      if (!url) {
        setStatus('Enter a valid http or https URL.');
        input?.focus();
        return;
      }

      let slug = createSlug();
      while (bookmarks.some((bookmark) => bookmark.slug === slug)) slug = createSlug();

      bookmarks.push({ url, slug });
      const persisted = persistBookmarks();
      renderBookmarks();
      if (input) input.value = '';
      setStatus(persisted
        ? `Saved ${formatBookmark({ url, slug })}.`
        : `Added for this session only; browser storage is unavailable.`);
    } catch {
      setStatus('Could not save this bookmark. Please try again.');
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks from this device?')) return;
    bookmarks = [];
    const persisted = persistBookmarks();
    renderBookmarks();
    setStatus(persisted
      ? 'All bookmarks cleared.'
      : 'Cleared for this session only; browser storage is unavailable.');
  });

  readBookmarks();
  renderBookmarks();
</script>

<style>
  .bookmark-manager {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: color-mix(in srgb, Canvas 94%, currentColor 6%);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  form { margin-top: 0; }
  input { min-height: 2.8rem; }
  button { transition: filter 120ms ease, transform 120ms ease; }
  button:active { transform: translateY(1px); }

  .hint { margin-bottom: 0.75rem; }
  .status {
    min-height: 1.25rem;
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .empty {
    padding: 1.75rem 1rem;
    background: color-mix(in srgb, Canvas 75%, transparent);
  }

  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.5rem 0 0.75rem;
  }

  .list-title { margin: 0; font-size: 1rem; font-family: var(--font-head); }
  .clear, .copy {
    background: transparent;
    color: inherit;
    border: 1px solid var(--border);
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .clear:hover, .copy:hover { border-color: currentColor; }

  .bookmark-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .bookmark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.35rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, Canvas 88%, currentColor 4%);
  }
  .url { flex: 1 1 12rem; overflow-wrap: anywhere; }
  .slug {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .copy { margin-left: 0.35rem; }

  @media (max-width: 32rem) {
    .bookmark-manager { padding: 1rem; }
    .bookmark { gap: 0.5rem 0.25rem; }
  }
</style>
